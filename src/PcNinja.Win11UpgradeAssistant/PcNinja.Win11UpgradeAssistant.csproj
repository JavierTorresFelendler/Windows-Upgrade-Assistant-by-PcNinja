<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PcNinja.ico</ApplicationIcon>
    <AssemblyName>Windows-Upgrade-Assistant-By-PcNinja</AssemblyName>
    <RootNamespace>PcNinja.Win11UpgradeAssistant</RootNamespace>
    <Product>Windows Upgrade Assistant By PcNinja</Product>
    <Company>PcNinja</Company>
    <Authors>PcNinja</Authors>
    <Description>Standalone Windows upgrade assistant for advanced home users.</Description>
    <Copyright>Copyright © 2026 PcNinja</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PcNinja.Win11Upgrade.Core\PcNinja.Win11Upgrade.Core.csproj" />
    <EmbeddedResource Include="Assets\PcNinja-mascot.png" LogicalName="PcNinja.Win11UpgradeAssistant.Assets.PcNinja-mascot.png" />
  </ItemGroup>
</Project>
